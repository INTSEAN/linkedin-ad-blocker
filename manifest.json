{
  "manifest_version": 3,
  "name": "LinkedIn Ad Blocker",
  "version": "1.0",
  "description": "Blocks ads on LinkedIn by removing known ad elements from the DOM.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "48": "/images/icon-48.png",
      "128": "/images/icon-128.png"
    }
  }
}
